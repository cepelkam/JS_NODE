<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
<header>
    <h1>GTA V Hub</h1>
    <nav>
        <a href="/">Domů</a>
        <a href="/characters">Postavy</a>
        <a href="/locations">Lokace</a>
        <% if (user) { %>
            <span>Přihlášen: <%= user.username %></span>
            <a href="/account">Můj účet</a>
            <form class="logout-form" method="post" action="/logout"><button type="submit">Odhlásit</button></form>
        <% } else { %>
            <a href="/login">Přihlásit</a>
            <a href="/register">Registrovat</a>
        <% } %>
    </nav>
</header>
