<%- include("partials/header", { title }) %>

<main>
    <h2>Postavy</h2>
    <% if (user) { %>
        <form id="character-form">
            <input name="name" placeholder="Jméno postavy" required>
            <input name="role" placeholder="Role" required>
            <input name="description" placeholder="Popis">
            <button type="submit">Přidat postavu</button>
        </form>
    <% } else { %>
        <p>Pro přidání nebo mazání vlastních postav se nejdřív <a href="/login">přihlas</a>.</p>
    <% } %>
    <p id="message" role="status"></p>

    <section id="characters">
        <% characters.forEach(character => { %>
            <article class="card">
                <% if (character.image) { %><img class="card-image character-image" src="<%= character.image %>" alt="<%= character.name %>"><% } %>
                <h3><%= character.name %></h3>
                <strong><%= character.role %></strong>
                <small>Autor: <%= character.author %></small>
                <p><%= character.description %></p>
                <% if (user && character.userId === user.id) { %>
                    <a class="edit" href="/characters/<%= character.id %>/edit">Upravit</a>
                    <button class="delete" data-id="<%= character.id %>">Smazat</button>
                <% } %>
            </article>
        <% }) %>
    </section>
</main>

<script>
const list = document.querySelector('#characters');
const message = document.querySelector('#message');
const currentUserId = <%= user ? user.id : 'null' %>;

function escapeHtml(value) {
    return String(value).replace(/[&<>'"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#039;', '"': '&quot;' }[c]));
}

async function loadCharacters() {
    const response = await fetch('/api/characters');
    const characters = await response.json();
    list.innerHTML = characters.map(character => `
        <article class="card">
            ${character.image ? `<img class="card-image character-image" src="${character.image}" alt="${escapeHtml(character.name)}">` : '<div class="image-placeholder">GTA V</div>'}
            <h3>${escapeHtml(character.name)}</h3>
            <strong>${escapeHtml(character.role)}</strong>
            <small>Autor: ${escapeHtml(character.author)}</small>
            <p>${escapeHtml(character.description)}</p>
            ${currentUserId === character.userId ? `<a class="edit" href="/characters/${character.id}/edit">Upravit</a><button class="delete" data-id="${character.id}">Smazat</button>` : ''}
        </article>`).join('');
}

document.querySelector('#character-form')?.addEventListener('submit', async event => {
    event.preventDefault();
    const data = Object.fromEntries(new FormData(event.target));
    const response = await fetch('/api/characters', {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data)
    });
    const result = await response.json().catch(() => ({}));
    if (!response.ok) { message.textContent = result.error || 'Záznam se nepodařilo uložit.'; return; }
    event.target.reset();
    message.textContent = 'Postava byla přidána.';
    await loadCharacters();
});

list.addEventListener('click', async event => {
    if (!event.target.classList.contains('delete')) return;
    const response = await fetch(`/api/characters/${event.target.dataset.id}`, { method: 'DELETE' });
    message.textContent = response.ok ? 'Postava byla smazána.' : 'Postavu se nepodařilo smazat.';
    await loadCharacters();
});
</script>

<%- include("partials/footer") %>
